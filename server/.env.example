NODE_ENV=development
PORT=3001
# Mots de passe des comptes (à définir uniquement dans .env local et dans Render, JAMAIS ici)
ACCOUNT_TITOU_PWD=
ACCOUNT_THOMAS_PWD=
ACCOUNT_HUGO_PWD=
ACCOUNT_LILOU_PWD=
ACCOUNT_MATTEO_PWD=

CLIENT_URL=http://localhost:5173

# Sauvegarde cloud des comptes (Gist GitHub PRIVÉ)
# Token : scope "gist" uniquement
GITHUB_TOKEN=
GITHUB_GIST_ID=

# Facultatif : active les routes /api/backup/* (laisser vide = désactivées)
BACKUP_TOKEN=
